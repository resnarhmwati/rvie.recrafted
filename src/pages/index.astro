---
import BaseLayout from "../layouts/BaseLayout.astro";

const products = [
  { number: "01", name: "BOUND", descriptor: "Detail rantai silang dengan ornamen metal.", image: "/images/bound.jpg", alt: "RVie Recrafted Bound tie" },
  { number: "02", name: "BROKEN", descriptor: "Kombinasi star charm, safety pin, dan detail rantai.", image: "/images/model-02.jpg", alt: "RVie Recrafted Broken tie" },
  { number: "03", name: "BLOOM", descriptor: "Motif abstrak silver dengan sentuhan star charm.", image: "/images/model-03.jpg", alt: "RVie Recrafted Bloom tie" },
  { number: "04", name: "UNBOUND", descriptor: "Detail rantai bertingkat dengan ornamen metal.", image: "/images/model-04.jpg", alt: "RVie Recrafted Unbound tie" },
];
---
<BaseLayout>
  <div class="announcement">REWORKED DETAILS. DISTINCTIVE CHARACTER. <span>— RVie RECRAFTED</span></div>
  <header class="site-header">
    <a class="brand" href="#home" aria-label="RVie Recrafted home">
      <img src="/images/logo.png" alt="RVie Recrafted logo" onerror="this.style.display='none'; this.nextElementSibling.style.display='block'" />
      <span class="brand-fallback">RVie <small>RECRAFTED</small></span>
    </a>
    <nav class="desktop-nav" aria-label="Main navigation">
      <a href="#collection">Collection</a>
      <a href="#about">Our story</a>
      <a href="#contact">Contact</a>
    </nav>
    <a class="top-order" href="https://id.shp.ee/Qi9L1sBX" target="_blank" rel="noreferrer">ORDER ON SHOPEE <span>↗</span></a>
    <button class="menu-toggle" aria-label="Open navigation" aria-expanded="false">☰</button>
  </header>

  <main>
    <section class="hero" id="home">
      <div class="hero-image" role="img" aria-label="Editorial styling of a reworked black tie"></div>
      <div class="hero-shade"></div>
      <div class="hero-copy">
        <p class="eyebrow">RVie RECRAFTED · TIE OBJECTS</p>
        <h1>Redefine your style.<br /><em>Wear your identity.</em></h1>
        <p class="hero-sub">Classic ties, reimagined with details that speak for you.</p>
        <a class="text-link" href="#collection">EXPLORE THE COLLECTION <span>↓</span></a>
      </div>
      <div class="hero-index"><span>01</span> / 04</div>
      <div class="vertical-note">RECRAFTED WITH INTENTION</div>
    </section>

    <section class="intro" id="about">
      <div class="section-kicker"><span>01 — THE BRAND</span><span>RVie RECRAFTED</span></div>
      <div class="intro-grid">
        <h2>Not just an accessory.<br /><em>A point of view.</em></h2>
        <div class="intro-text">
          <p class="intro-lead">Redefine your style. Wear your identity.</p>
          <p>Setiap detail dibuat untuk menghadirkan karakter, bukan sekadar mengikuti tren.</p>
          <a class="text-link dark-link" href="#contact">GET TO KNOW US <span>↗</span></a>
        </div>
      </div>
      <div class="thin-rule"></div>
    </section>

    <section class="collection" id="collection">
      <div class="section-kicker"><span>02 — THE COLLECTION</span><span>FOUR DISTINCT EXPRESSIONS</span></div>
      <div class="collection-heading">
        <h2>Wear it <em>your way.</em></h2>
        <p>Reworked ties. Thoughtful hardware.<br />Made to carry your character.</p>
      </div>
      <div class="product-grid">
        {products.map((product) => (
          <article class="product-card">
            <div class="product-meta">
              <span class="product-number">{product.number}</span>
              <div class="product-info">
                <h3>{product.name}</h3>
                <p>{product.descriptor}</p>
              </div>
              <span class="product-arrow">↗</span>
            </div>
            <a class="product-image" href="https://shopee.co.id/" target="_blank" rel="noreferrer" aria-label={`Order ${product.name} on Shopee`}>
              <img src={product.image} alt={product.alt} loading="lazy" />
              <span class="image-cta">VIEW ON SHOPEE ↗</span>
            </a>
          </article>
        ))}
      </div>
      <p class="collection-note">A small collection, made with a different point of view.</p>
    </section>

    <section class="manifesto">
      <div class="manifesto-mark">✳</div>
      <p class="eyebrow">THE RVie STATEMENT</p>
      <h2>Redefine your style.<br /><em>Wear your identity.</em></h2>
      <p class="manifesto-copy">Setiap detail dibuat untuk menghadirkan karakter,<br class="desktop-only" /> bukan sekadar mengikuti tren.</p>
    </section>

    <section class="contact" id="contact">
      <div class="section-kicker"><span>03 — CONNECT</span><span>LET'S MAKE IT YOURS</span></div>
      <div class="contact-grid">
        <div>
          <p class="eyebrow">FIND YOUR NEXT DETAIL</p>
          <h2>Your style.<br /><em>Your statement.</em></h2>
        </div>
        <div class="contact-actions">
          <a class="contact-link" href="https://id.shp.ee/Qi9L1sBX" target="_blank" rel="noreferrer"><span>Shop the collection</span><b>SHOPEE ↗</b></a>
          <a class="contact-link" href="https://wa.me/6282258724734" target="_blank" rel="noreferrer"><span>Questions & custom inquiries</span><b>WHATSAPP ↗</b></a>
          <a class="contact-link" href="https://www.tiktok.com/@rvie.recrafted" target="_blank" rel="noreferrer"><span>Follow the process</span><b>TIKTOK ↗</b></a>
        </div>
      </div>
    </section>
  </main>

  <footer>
    <a class="footer-brand" href="#home">RVie <span>RECRAFTED</span></a>
    <p>Redefine your style. Wear your identity.</p>
    <span class="copyright">© 2026 RVie RECRAFTED</span>
  </footer>

  <script>
    const menuButton = document.querySelector('.menu-toggle');
    const nav = document.querySelector('.desktop-nav');
    menuButton?.addEventListener('click', () => {
      const open = nav.classList.toggle('nav-open');
      menuButton.setAttribute('aria-expanded', String(open));
      menuButton.textContent = open ? '×' : '☰';
    });
    nav?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => {
      nav.classList.remove('nav-open');
      menuButton?.setAttribute('aria-expanded', 'false');
      if (menuButton) menuButton.textContent = '☰';
    }));
  </script>

  <style>
    :global(*) { box-sizing: border-box; }
    :global(html) { scroll-behavior: smooth; }
    :global(body) { margin: 0; background: #f1f0ed; color: #171716; font-family: 'DM Sans', sans-serif; }
    :global(a) { color: inherit; text-decoration: none; }
    .announcement { padding: 9px 20px; text-align: center; font-size: 9px; letter-spacing: .18em; background: #111; color: #e7e5df; }
    .announcement span { color: #999; }
    .site-header { height: 90px; padding: 0 5.5%; display: flex; align-items: center; justify-content: space-between; gap: 24px; background: #111; position: relative; z-index: 10; }
    .brand { display: flex; align-items: center; flex-shrink: 0; }
    .brand img { height: 60px; width: auto; object-fit: contain; }
    .brand-fallback { font: 36px 'Italiana', serif; letter-spacing: -.07em; display: none; color: #f1f0ed; }
    .brand-fallback small { display: block; font: 8px 'DM Sans', sans-serif; letter-spacing: .48em; margin: -2px 0 0 7px; }
    .desktop-nav { display: flex; gap: 34px; align-items: center; }
    .desktop-nav a { font-size: 10px; letter-spacing: .13em; text-transform: uppercase; color: #aaa7a0; transition: color .2s; }
    .desktop-nav a:hover { color: #fff; }
    .top-order { border: 1px solid #aaa7a0; padding: 12px 15px; font-size: 9px; letter-spacing: .13em; display: inline-flex; gap: 18px; align-items: center; color: #f1f0ed; transition: background .2s, color .2s; }
    .top-order:hover { background: #f1f0ed; color: #111; }
    .menu-toggle { display: none; border: 0; background: transparent; font-size: 22px; }
    .hero { height: min(690px, 78vw); min-height: 470px; background: #171717; position: relative; overflow: hidden; color: #f4f2ed; display: flex; align-items: center; }
    .hero-image { position: absolute; inset: 0; background-image: linear-gradient(90deg, rgba(0,0,0,.64), rgba(0,0,0,.12) 70%), url('/images/hero.jpg'); background-size: cover; background-position: center 42%; filter: grayscale(1); }
    .hero-shade { position: absolute; inset: 0; background: linear-gradient(0deg, rgba(0,0,0,.25), transparent 50%); }
    .hero-copy { position: relative; z-index: 1; padding: 0 10%; max-width: 820px; }
    .eyebrow { font-size: 9px; letter-spacing: .22em; text-transform: uppercase; color: #aaa7a0; }
    h1, h2 { font-family: 'Italiana', serif; font-weight: 400; letter-spacing: -.035em; }
    .hero h1 { font-size: clamp(46px, 7.1vw, 92px); line-height: .99; margin: 25px 0 18px; }
    h1 em, h2 em { font-weight: 400; color: #aaa69f; }
    .hero-sub { font-size: 12px; letter-spacing: .04em; color: #d0cec9; margin-bottom: 34px; }
    .text-link { display: inline-flex; align-items: center; gap: 22px; padding-bottom: 9px; border-bottom: 1px solid #8e8c86; font-size: 9px; letter-spacing: .16em; }
    .text-link span { font-size: 15px; }
    .hero-index { position: absolute; right: 5.5%; bottom: 30px; font-size: 9px; letter-spacing: .15em; color: #c3c1bc; }
    .hero-index span { color: #fff; }
    .vertical-note { position: absolute; right: 24px; top: 50%; writing-mode: vertical-rl; font-size: 8px; letter-spacing: .2em; color: #aaa; }
    .intro, .collection, .contact { padding: 92px 8.5%; }
    .section-kicker { display: flex; justify-content: space-between; gap: 20px; font-size: 8px; letter-spacing: .18em; color: #77736d; }
    .intro-grid { display: grid; grid-template-columns: 1.1fr .7fr; gap: 10%; align-items: end; padding: 55px 0 60px; }
    .intro h2, .collection h2, .contact h2 { font-size: clamp(40px, 5.6vw, 72px); line-height: 1.02; margin: 0; }
    .intro h2 em, .collection h2 em, .contact h2 em { color: #8b8882; }
    .intro-text { max-width: 370px; font-size: 13px; line-height: 1.9; color: #5e5b56; }
    .intro-lead { font-size: 15px; color: #171716; }
    .dark-link { margin-top: 16px; border-color: #aaa69f; color: #171716; }
    .thin-rule { height: 1px; background: #d5d2cc; }
    .collection { background: #e7e5e0; padding-top: 78px; }
    .collection-heading { display: flex; justify-content: space-between; align-items: end; gap: 25px; margin: 45px 0 42px; }
    .collection-heading p { font-size: 11px; line-height: 1.8; color: #77736d; margin: 0 0 5px; }
    .product-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 48px 22px; }
    .product-image { position: relative; display: block; overflow: hidden; background: #d4d2cd; aspect-ratio: 1 / 1; }
    .product-image img { width: 100%; height: 100%; display: block; object-fit: cover; transition: transform .6s cubic-bezier(.2,.7,.2,1); }
    .product-image:hover img { transform: scale(1.035); }
    .image-cta { position: absolute; right: 15px; bottom: 15px; background: #f1f0ed; padding: 11px 13px; font-size: 8px; letter-spacing: .13em; opacity: 0; transform: translateY(5px); transition: .25s; }
    .product-image:hover .image-cta { opacity: 1; transform: translateY(0); }
    .product-meta { display: flex; align-items: center; gap: 12px; padding: 0 2px 14px; }
    .product-number { font-size: 9px; letter-spacing: .15em; color: #aaa7a0; min-width: 22px; }
    .product-info { flex: 1; }
    .product-meta h3 { margin: 0 0 4px; font-size: 11px; font-weight: 600; letter-spacing: .14em; }
    .product-meta p { margin: 0; font-size: 10px; color: #77736d; line-height: 1.5; }
    .product-arrow { font-size: 17px; margin-left: auto; }
    .collection-note { text-align: center; margin: 65px 0 0; color: #77736d; font: italic 18px 'Italiana', serif; }
    .manifesto { background: #141414; color: #f2f0eb; text-align: center; padding: 95px 20px 100px; }
    .manifesto-mark { font-size: 27px; color: #b9b5ad; margin-bottom: 22px; }
    .manifesto h2 { font-size: clamp(39px, 6vw, 76px); line-height: 1.03; margin: 28px 0 20px; }
    .manifesto h2 em { color: #aaa69f; }
    .manifesto-copy { color: #b7b4ae; font-size: 12px; line-height: 1.9; }
    .contact { padding-top: 85px; padding-bottom: 100px; }
    .contact-grid { display: grid; grid-template-columns: 1fr .8fr; gap: 10%; align-items: center; margin-top: 60px; }
    .contact h2 { margin-top: 22px; }
    .contact-actions { border-top: 1px solid #c9c6c0; }
    .contact-link { display: flex; justify-content: space-between; align-items: center; gap: 15px; padding: 20px 0; border-bottom: 1px solid #c9c6c0; font-size: 11px; color: #696660; }
    .contact-link b { font-size: 9px; letter-spacing: .12em; color: #171716; font-weight: 500; white-space: nowrap; }
    .contact-link:hover b { color: #8a8278; }
    footer { background: #111; color: #d9d7d1; padding: 28px 8.5%; display: flex; justify-content: space-between; align-items: center; gap: 20px; }
    .footer-brand { font: 25px 'Italiana', serif; }
    .footer-brand span { display: block; font: 7px 'DM Sans', sans-serif; letter-spacing: .45em; margin: 3px 0 0 4px; }
    footer p, .copyright { color: #88857f; font-size: 9px; letter-spacing: .08em; }
    @media (max-width: 700px) {
      .announcement { font-size: 7px; letter-spacing: .12em; padding: 8px 8px; }
      .site-header { height: 80px; padding: 0 5%; }
      .brand img { height: 52px; width: auto; max-width: 220px; }
      .brand-fallback { font-size: 29px; color: #f1f0ed; }
      .top-order { padding: 10px 10px; gap: 8px; font-size: 8px; }
      .menu-toggle { display: block; margin-left: 12px; color: #f1f0ed; }
      .desktop-nav { display: none; position: absolute; top: 90px; left: 0; right: 0; padding: 20px 5%; background: #111; border-top: 1px solid #2a2a2a; flex-direction: column; align-items: flex-start; gap: 20px; }
      .desktop-nav.nav-open { display: flex; }
      .hero { min-height: 560px; height: 82vh; max-height: 740px; align-items: end; }
      .hero-image { background-position: 53% center; }
      .hero-copy { padding: 0 7% 78px; }
      .hero h1 { font-size: clamp(43px, 12vw, 66px); margin: 22px 0 15px; }
      .hero-sub { max-width: 280px; line-height: 1.7; font-size: 11px; }
      .vertical-note { right: 12px; font-size: 7px; }
      .intro, .collection, .contact { padding: 62px 6%; }
      .section-kicker { font-size: 7px; letter-spacing: .12em; }
      .intro-grid { grid-template-columns: 1fr; gap: 28px; padding: 38px 0 42px; }
      .intro h2, .collection h2, .contact h2 { font-size: clamp(42px, 11vw, 58px); }
      .intro-text { font-size: 12px; }
      .collection-heading { display: block; margin: 38px 0 28px; }
      .collection-heading p { margin-top: 17px; }
      .product-grid { gap: 30px 12px; }
      .product-image { aspect-ratio: 1 / 1; }
      .product-meta { padding: 0 2px 10px; gap: 8px; }
      .product-number { font-size: 8px; min-width: 18px; }
      .product-meta h3 { font-size: 9px; letter-spacing: .1em; }
      .product-meta p { font-size: 8px; line-height: 1.5; }
      .product-arrow { font-size: 14px; }
      .image-cta { opacity: 1; transform: none; font-size: 7px; padding: 8px; right: 8px; bottom: 8px; }
      .collection-note { margin-top: 43px; font-size: 16px; }
      .manifesto { padding: 72px 7%; }
      .manifesto h2 { font-size: clamp(38px, 10vw, 58px); }
      .manifesto-copy { font-size: 11px; }
      .desktop-only { display: none; }
      .contact-grid { grid-template-columns: 1fr; gap: 38px; margin-top: 40px; }
      .contact-link { font-size: 10px; }
      footer { padding: 25px 6%; flex-wrap: wrap; }
      footer p { order: 3; flex-basis: 100%; margin: 0; }
      .copyright { font-size: 8px; }
    }
    @media (max-width: 380px) {
      .top-order { font-size: 7px; padding: 9px 7px; }
      .brand { min-width: 80px; }
      .brand img { max-width: 82px; }
      .product-grid { grid-template-columns: 1fr; }
    }
  </style>
</BaseLayout>
